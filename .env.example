# Copy to .env (never commit .env). Docker Compose reads this file automatically.

# Which compose profile `docker compose up` starts: dev (vite hot reload) or demo (built web via nginx)
COMPOSE_PROFILES=dev

# Host ports
WEB_PORT=5173
API_PORT=8000
STT_PORT=8001
LLM_PORT=8002

# Frontend: 1 = use the in-memory mock api (no backend needed), 0 = talk to the real api.
# Keep 1 until the backend session endpoints exist (D1, D5).
VITE_API_MOCK=1

# Filled in after spikes A1 / B2 (not used by the stubs yet)
# WHISPER_MODEL=
# LLM_MODEL=
