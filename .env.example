# Copy to .env (never commit .env). Docker Compose reads this file automatically.

# Which compose profile `docker compose up` starts: dev (vite hot reload) or demo (built web via nginx)
COMPOSE_PROFILES=dev

# Host ports
WEB_PORT=5173
API_PORT=8000
STT_PORT=8001
LLM_PORT=8002

# Frontend: 1 = use the in-memory mock api (no backend needed), 0 = talk to the real api.
# CP2 uses 0 for the real API; 1 is only for isolated frontend development.
VITE_API_MOCK=0

# Evaluation endpoints (admin screen). Off by default; scripts/start-cp2.* turn it on for the demo.
EVAL_MODE=0
WHISPER_MODEL=small
# Extraction model, served by Ollama (see DECISIONS.md). gemma3:1b for now; gemma4:e4b for the recorded workstation experiments.
LLM_MODEL=gemma3:1b
# Machines with an NVIDIA GPU: uncomment to run Ollama on the GPU.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
